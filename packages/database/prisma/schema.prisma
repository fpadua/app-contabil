generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model EconomicIndex {
  id          String                      @id @default(uuid()) @db.Uuid
  slug        String                      @unique
  name        String
  source      String
  periodicity String                      @default("MONTHLY")
  basis       Json?
  origin      String                      @default("SYNCED")
  active      Boolean                     @default(true)
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt
  values      EconomicIndexValue[]
  histories   EconomicIndexValueHistory[]
}

model EconomicIndexValue {
  id                  String        @id @default(uuid()) @db.Uuid
  economicIndexId     String        @db.Uuid
  referenceDate       DateTime      @db.Date
  monthlyValue        Decimal?      @db.Decimal(18, 10)
  accumulatedValue    Decimal?      @db.Decimal(24, 12)
  accumulatedPositive Decimal?      @db.Decimal(24, 12)
  published           Boolean       @default(true)
  sourceUrl           String?
  rawData             Json?
  importedAt          DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  economicIndex       EconomicIndex @relation(fields: [economicIndexId], references: [id])

  @@unique([economicIndexId, referenceDate])
  @@index([referenceDate])
}

model EconomicIndexValueHistory {
  id                       String                @id @default(uuid()) @db.Uuid
  economicIndexId          String                @db.Uuid
  referenceDate            DateTime              @db.Date
  previousMonthlyValue     Decimal?              @db.Decimal(18, 10)
  newMonthlyValue          Decimal?              @db.Decimal(18, 10)
  previousAccumulatedValue Decimal?              @db.Decimal(24, 12)
  newAccumulatedValue      Decimal?              @db.Decimal(24, 12)
  previousPublished        Boolean?
  newPublished             Boolean
  syncRunId                String?               @db.Uuid
  changedAt                DateTime              @default(now())
  economicIndex            EconomicIndex         @relation(fields: [economicIndexId], references: [id])
  syncRun                  EconomicIndexSyncRun? @relation(fields: [syncRunId], references: [id])

  @@index([economicIndexId, referenceDate])
  @@index([syncRunId])
}

model EconomicIndexSyncRun {
  id          String                      @id @default(uuid()) @db.Uuid
  status      IndexSyncStatus             @default(RUNNING)
  source      String
  requestedBy String?
  fromPeriod  String?
  toPeriod    String?
  inserted    Int                         @default(0)
  updated     Int                         @default(0)
  unchanged   Int                         @default(0)
  failed      Int                         @default(0)
  error       String?
  startedAt   DateTime                    @default(now())
  finishedAt  DateTime?
  histories   EconomicIndexValueHistory[]
}

enum IndexSyncStatus {
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
}

model CalculationRule {
  id          String   @id
  name        String
  description String
  version     Int      @default(1)
  sourceFile  String
  sourceSheet String
  sourceCells String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Client {
  id         String    @id @default(uuid()) @db.Uuid
  personType String    @default("Pessoa física")
  name       String
  document   String?
  email      String?
  phone      String?
  notes      String?
  status     String    @default("Ativo")
createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  processes   Process[]
  calculations Calculation[]

  @@index([name])
}

model Process {
  id              String     @id @default(uuid()) @db.Uuid
  clientId        String?    @db.Uuid
  client          Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  title           String
  number          String?
  calculationType String     @default("Correção monetária")
  status          String     @default("Em andamento")
  court           String?
  division        String?
  notes           String?
  documents       Document[]
  calculations    Calculation[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([clientId])
}

model Calculation {
  id                 String    @id @default(uuid()) @db.Uuid
  title              String
  calculationType    String    @default("Correção monetária")
  clientId           String?   @db.Uuid
  client             Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  processId          String?   @db.Uuid
  process            Process?  @relation(fields: [processId], references: [id], onDelete: SetNull)
  indexSlug          String?
  startDate          DateTime  @db.Date
  endDate            DateTime  @db.Date
  principalInCents   Int
  accumulatedFactor  Decimal?  @db.Decimal(20, 14)
  correctedInCents   Int?
  correctionInCents  Int?
  traceabilityRuleId String    @default("REGRA-CM-001")
  months             Json?
  installments       Json?
  params             Json?
  status             String    @default("Concluído")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([clientId])
  @@index([processId])
  @@index([indexSlug])
}

model Document {
  id          String    @id @default(uuid()) @db.Uuid
  title       String
  category    String
  description String?
  fileName    String?
  fileSize    Int?
  mimeType    String?
  storageKey  String?
  processId   String?   @db.Uuid
  process     Process?  @relation(fields: [processId], references: [id], onDelete: SetNull)
  source      String?
  status      String    @default("Em revisão")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([processId])
}
